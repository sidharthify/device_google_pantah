# Battery
persist.vendor.testing_battery_profile=2

# Bluetooth
bluetooth.device.class_of_device=90,66,12
bluetooth.profile.a2dp.source.enabled?=true
bluetooth.profile.asha.central.enabled?=true
bluetooth.profile.avrcp.target.enabled?=true
bluetooth.profile.bas.client.enabled?=true
bluetooth.profile.gatt.enabled?=true
bluetooth.profile.hfp.ag.enabled?=true
bluetooth.profile.hid.device.enabled?=true
bluetooth.profile.hid.host.enabled?=true
bluetooth.profile.map.server.enabled?=true
bluetooth.profile.opp.enabled?=true
bluetooth.profile.pan.nap.enabled?=true
bluetooth.profile.pan.panu.enabled?=true
bluetooth.profile.pbap.server.enabled?=true
bluetooth.profile.sap.server.enabled?=true
persist.bluetooth.a2dp_aac.vbr_supported=true
persist.bluetooth.bqr.min_interval_ms=500

# bluetooth
bluetooth.ble.allow_enc_with_bredr=true
bluetooth.leaudio.dual_bidirection_swb.supported=false
bluetooth.leaudio.toggle_visible_for_asha=false
bluetooth.profile.bap.unicast.client.enabled?=true
bluetooth.profile.ccp.server.enabled?=true
bluetooth.profile.csip.set_coordinator.enabled?=true
bluetooth.profile.hap.client.enabled?=true
bluetooth.profile.hap.enabled_by_default=false
bluetooth.profile.mcp.server.enabled?=true
bluetooth.profile.vcp.controller.enabled?=true
persist.bluetooth.bqr.event_mask=94
persist.bluetooth.firmware.selection=BCM.hcd
persist.bluetooth.leaudio.allow_list=SM-R510,WF-1000XM5,SM-R630,WH-1000XM6,880066-0100,LinkBuds Fit,WF-1000XM6
persist.bluetooth.leaudio.allow_list_extend=LinkBuds Open
persist.bluetooth.leaudio.notify.idle.during.call=true
persist.bluetooth.leaudio_offload.disabled=false
persist.bluetooth.opus.enabled=true
ro.bluetooth.leaudio_offload.supported=true
ro.bluetooth.leaudio_switcher.supported=true

# Camera
ro.frameworks.camera2.extension.service=com.google.android.apps.camera.services.extensions.service.CameraExtensions
ro.vendor.camera.extensions.package=com.google.android.apps.camera.services

# Cutout
ro.support_hide_display_cutout=true

# Device family
ro.build.device_family=P10C10L10

# Dumpstate
dumpstate.strict_run=false

# e-SIM
masterclear.allow_retain_esim_profiles_after_fdr=true

# EUICC
euicc.seamless_transfer_enabled_in_non_qs=true

# fsck
persist.fsck.disable_linear_lookup=on
ro.preventative_fsck=1

# FUSE
persist.sys.fuse.passthrough.enable=true
ro.fuse.bpf.enabled=true

# Google Assistant
ro.opa.eligible_device=true

# google keyboard
ro.com.google.ime.kb_pad_port_b=8

# Postinstall
ro.postinstall.fstab.prefix=/product

# Quick start
ro.quick_start.oem_id=00e0

# Radio
persist.radio.multisim.config=dsds

# Strongbox
ro.strongbox.manufacturer=Google
ro.strongbox.model=Titan-M2

# Telephony
persist.radio.reboot_on_modem_change=false
persist.vendor.ril.camp_on_earlier=1

# Thermal
ro.thermal_warmreset=true

# Window extensions
persist.settings.large_screen_opt.enabled=false

# ZRAM
ro.zram_backing_device_min_free_mb=1536
